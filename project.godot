; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Chris beat em up tutorial"
run/main_scene="uid://ck656tkf1aes1"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://Art/Players/icon.svg"

[display]

window/size/viewport_height=565
window/stretch/mode="viewport"
window/stretch/aspect="expand"
window/stretch/scale_mode="integer"

[layer_names]

2d_physics/layer_1="Walls"
2d_physics/layer_2="Players"
2d_physics/layer_3="Enemies"
2d_physics/layer_4="Destructables"
2d_physics/layer_5="Collectables"

[physics]

